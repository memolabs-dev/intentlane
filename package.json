{
  "name": "intentlane",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && pnpm bundle",
    "bundle": "esbuild packages/cli/src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=packages/cli/dist/index.cjs",
    "test": "vitest run && node --test test/hooks.test.mjs",
    "validate": "tsx packages/cli/src/index.ts validate",
    "generate": "tsx packages/cli/src/index.ts generate",
    "verify": "rm -rf .intentlane/generated /tmp/intentlane-second && pnpm build && pnpm test && pnpm validate && pnpm generate --output .intentlane/generated && pnpm generate --output .intentlane/generated --check && pnpm generate --output /tmp/intentlane-second && diff -r .intentlane/generated /tmp/intentlane-second",
    "prepare": "sh scripts/install-git-hooks.sh",
    "hooks:install": "sh scripts/install-git-hooks.sh",
    "check:staged": "pnpm exec tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  }
}
